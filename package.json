{
  "name": "muspeth",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/executeSqlFile.ts db/seed.sql",
    "db:import-interactions": "node scripts/importGlobiInteractions.ts",
    "db:import-networks": "node scripts/importMangalNetworks.ts",
    "db:import-likeness": "node scripts/importTraitLikeness.ts",
    "db:import-places-sounds": "node scripts/importPlacesAndSounds.ts",
    "db:import-substances-culture": "node scripts/importSubstancesAndCulture.ts",
    "db:import-words-motifs": "node scripts/importWordsMotifs.ts",
    "db:import-images": "node scripts/importImages.ts",
    "db:import-taxa": "node scripts/importGbifTaxa.ts",
    "db:import-all": "npm run db:import-interactions && npm run db:import-networks && npm run db:import-likeness && npm run db:import-places-sounds && npm run db:import-substances-culture && npm run db:import-words-motifs && npm run db:import-images && npm run db:import-taxa",
    "typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "npm run typegen && tsc -b",
    "lint": "biome check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "simple-git-hooks && npm run typegen",
    "lint:fix": "biome check --write"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sql.js": "^1.14.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "simple-git-hooks": true,
    "workerd": true
  }
}
