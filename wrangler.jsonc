{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muspeth",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_data/*"]
  },
  "observability": {
    "enabled": true
  }
}
